# --- AI provider -------------------------------------------------------
# Set to "true" to use the mock AI provider (no API key needed, instant
# placeholder images/text). Also auto-enabled whenever OPENAI_API_KEY is empty.
MOCK_AI_PROVIDER=true

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-5-mini

# Which provider implementation to use for each capability. Currently only
# "openai" is implemented — add new providers in src/lib/ai/providers and
# extend src/lib/ai/provider.ts, no other code needs to change.
AI_IMAGE_PROVIDER=openai
AI_TEXT_PROVIDER=openai

# --- Supabase (auth, database, storage) --------------------------------
# Leave empty to run the app in local demo mode: pages render, generation
# works via the mock/real AI provider, but nothing is persisted and auth is
# disabled. Fill these in and run supabase/migrations/0001_init.sql to
# enable accounts, projects, credits and Brand Kit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
